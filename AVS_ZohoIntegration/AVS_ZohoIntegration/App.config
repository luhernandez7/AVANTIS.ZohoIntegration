<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
	</configSections>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
	<appSettings>
		<add key="licFilePath" value="" />
		<add key="companies:Config" value="[{&quot;dbServerType&quot;:&quot;dst_MSSQL2017&quot;,&quot;dbServer&quot;:&quot;LuisHernandez&quot;,&quot;dbUserName&quot;:&quot;sa&quot;,&quot;dbUserPassword&quot;:&quot;jDNq6dM+vG10Pue1UGv8gw==&quot;,&quot;dbName&quot;:&quot;SBODemoMX&quot;,&quot;sldServerName&quot;:&quot;LuisHernandez&quot;,&quot;sldServerPort&quot;:&quot;40000&quot;,&quot;licServerName&quot;:&quot;LuisHernandez&quot;,&quot;licServerPort&quot;:&quot;30000&quot;,&quot;sapUserName&quot;:&quot;manager&quot;,&quot;sapUserPassword&quot;:&quot;0OmIlL6YeLdmM1q21eUm8A==&quot;,&quot;Zoho_AccountsUrl&quot;:&quot;https://accounts.zoho.com/oauth/v2/token&quot;,&quot;Zoho_ClientId&quot;:&quot;GlfYDddizE4gpYbAqVC4+TnjvgHMGJyHAanPwqvTFqxOgBivxrU6ZLDjQK3DiA7f&quot;,&quot;Zoho_ClientSecret&quot;:&quot;PYQRsmXo3O5Ia9ltG5r7i6HEsvFU3BI4/Zz/YmDQqZQaawoOqoaYs5tsqGZPsErs&quot;,&quot;Zoho_RefreshToken&quot;:&quot;UYSnYcxbcEkj/pAftKpWMdSY2QL1nPv9OXvDTpG9ByVHni43pzoHKmLodflVDdIoaCpd9gr80DVy0f1lZfJxSALVbWQZ4kGEWqmCB6Q4oO0=&quot;,&quot;Zoho_EntityConfig&quot;:{&quot;OITM&quot;:{&quot;Direction&quot;:&quot;SAP_TO_ZOHO&quot;,&quot;Query&quot;:&quot;SELECT T0.ItemName AS 'Product_Name', T0.ItemCode AS 'Product_Code', CASE WHEN T0.validFor = 'Y' THEN 'true' ELSE 'false' END AS 'Product_Active', COALESCE(T1.Price, 0) AS 'Unit_Price', T0.SalUnitMsr AS 'Usage_Unit', T2.OnHand - T2.IsCommited + T2.OnOrder AS 'Qty_in_Stock', CASE WHEN T0.TaxType = 'Y' THEN 'true' ELSE 'false' END AS 'Taxable' FROM OITM T0 INNER JOIN ITM1 T1 ON T0.ItemCode = T1.ItemCode AND T1.PriceList = 1 INNER JOIN OITW T2 ON T0.ItemCode = T2.ItemCode AND T2.WhsCode = '05' LEFT JOIN OCRD T3 ON T0.CardCode = T3.CardCode WHERE T0.SellItem = 'Y' AND T0.validFor = 'Y' AND T0.U_AVS_Zoho_Sync = '0' AND (DATEADD(SECOND, (T0.UpdateTS / 100) * 3600 + (T0.UpdateTS % 100) * 60, CAST(CAST(T0.UpdateDate AS DATE) AS DATETIME)) &gt;= @LastSyncDate OR T2.UpdateDate &gt;= '2026-09-01')&quot;,&quot;Fields&quot;:&quot;Product_Name,Product_Code,Product_Active,Unit_Price,Usage_Unit,Qty_in_Stock,Taxable&quot;,&quot;API&quot;:&quot;https://www.zohoapis.com/crm/v8/Products&quot;,&quot;SapKeyField&quot;:&quot;Product_Code&quot;,&quot;DetailNodes&quot;:{&quot;Tax&quot;:{&quot;Query&quot;:&quot;SELECT T0.ItemCode AS 'Product_Code', '7343678000000608530' AS 'id', 'IVA - 16.0 %' AS 'value' FROM OITM T0 WHERE T0.ItemCode IN (@InClause)&quot;,&quot;Fields&quot;:&quot;Product_Code,id,value&quot;,&quot;DetailKey&quot;:&quot;Product_Code&quot;,&quot;DetailArrayName&quot;:&quot;Tax&quot;,&quot;IsSingleObject&quot;:false}}},&quot;ORDR&quot;:{&quot;Direction&quot;:&quot;ZOHO_TO_SAP&quot;,&quot;Query&quot;:&quot;&quot;,&quot;Fields&quot;:&quot;&quot;,&quot;API&quot;:&quot;https://www.zohoapis.com/crm/v8/Quotes?fields=Quoted_Items&amp;criteria=(Stage:equals:Approved)&quot;,&quot;SapKeyField&quot;:&quot;&quot;,&quot;DetailNodes&quot;:{}}}}]" />
	</appSettings>
	<log4net>
		<appender name="RollingFileAppender"  type="log4net.Appender.RollingFileAppender">
			<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
			<file type="log4net.Util.PatternString"  value="%property{LogFileName}" />
			<appendToFile value="true" />
			<rollingStyle value="Date" />
			<datePattern value="'.'yyyy-MM-dd'.log'" />
			<staticLogFileName value="false" />
			<maxSizeRollBackups value="30" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date{ISO8601} %level %logger - %message%newline%exception" />
			</layout>
		</appender>
		<appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date{ISO8601} %level %logger - %message%newline%exception" />
			</layout>
		</appender>
		<root>
			<level value="DEBUG" />
			<appender-ref ref="RollingFileAppender" />
			<appender-ref ref="ConsoleAppender" />
		</root>
	</log4net>
</configuration>